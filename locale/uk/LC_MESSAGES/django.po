#: apps/core/templates/core/home.html:497
msgid "A process built"
msgstr "Процес, створений"

#: apps/core/templates/core/home.html:498
msgid "to ship with confidence."
msgstr "щоб упевнено випускати."

#: apps/core/templates/core/home.html:504
