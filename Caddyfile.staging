# Staging: HTTPS with self-signed cert via `tls internal`.
# Browser will warn about untrusted cert — accept and proceed.
# Usage: docker compose -f docker-compose.staging.yml up

localhost:80 {
    redir https://localhost{uri}
}

localhost:443 {
    tls internal
    encode gzip

    handle_path /static/* {
        root * /srv/personalhub/staticfiles
        file_server
    }

    handle {
        reverse_proxy web:8000
    }

    header {
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }
}
